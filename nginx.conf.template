server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  #AUTH#
  add_header X-Robots-Tag "noindex, nofollow" always;
  gzip on; gzip_types text/css application/javascript application/json;
  location = /index.html { add_header Cache-Control "no-cache"; add_header X-Robots-Tag "noindex, nofollow" always; }
  location /assets/ { add_header Cache-Control "public, max-age=300"; add_header X-Robots-Tag "noindex, nofollow" always; }
  location / { try_files $uri $uri/ =404; }
}
